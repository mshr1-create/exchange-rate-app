###########################################
# fx-converter .env.example
# Copy to .env or .env.local and fill values
###########################################
# Your API key for the exchange rate provider
# Example provider: https://www.exchangerate-api.com/
VITE_EXCHANGE_RATE_API_KEY=
# Base URL without trailing slash
# e.g. https://v6.exchangerate-api.com/v6
VITE_EXCHANGE_RATE_BASE_URL=https://v6.exchangerate-api.com/v6
